{
  "name": "cloudeval-cli-monorepo",
  "version": "0.38.1",
  "private": true,
  "license": "LicenseRef-CloudEval-CLI",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "test": "node --test scripts/brand-consistency.test.mjs scripts/npm-package-metadata.test.mjs && bash scripts/install-onboarding.test.sh && pnpm -r --workspace-concurrency=1 --if-present test",
    "test:brand": "node --test scripts/brand-consistency.test.mjs",
    "test:npm-package": "node --test scripts/npm-package-metadata.test.mjs",
    "test:tui-runtime": "node --test scripts/tui-runtime.test.mjs",
    "release:verify-sync": "node scripts/verify-release-channel-sync.mjs",
    "test:installer": "bash scripts/install-onboarding.test.sh",
    "license:artifacts": "node scripts/generate-license-artifacts.mjs",
    "license:check": "node scripts/generate-license-artifacts.mjs --check",
    "license:audit": "node scripts/license-audit.mjs",
    "security:scan": "bash scripts/security-scan.sh",
    "prepublishOnly": "node scripts/prevent-root-npm-publish.mjs",
    "smoke:release:real": "bash scripts/smoke-release-real-backend.sh",
    "smoke:readonly:real": "bash scripts/smoke-readonly-real-backend.sh"
  },
  "pnpm": {
    "overrides": {
      "handlebars": "4.7.9",
      "@opentelemetry/propagator-jaeger": "2.10.0",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "protobufjs": "8.4.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "rollup": "4.60.3",
      "shell-quote": "1.10.0"
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.7",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "semantic-release": "^23.0.8",
    "tsup": "^8.3.0",
    "tsx": "^4.15.7",
    "typescript": "^5.6.3"
  }
}
